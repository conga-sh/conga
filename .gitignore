# Ignore everything
*

# But not these files...
!/.gitignore
!/.golangci.yaml
!**/.gitkeep

!*.go
!go.sum
!go.mod

!/.github/workflows/*.yml

!/RELEASING.md
!/release-please-config.json
!/.release-please-manifest.json

!/website/package.json
!/website/pnpm-lock.yaml
!/website/pnpm-workspace.yaml
!/website/tsconfig.json
!/website/astro.config.mjs
!/website/src/**
!/website/public/**
!/website/wrangler.jsonc

!/**/LICENSE
!/**/NOTICE
!**/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/llms.txt
!/docs/*.md

!/Taskfile.yaml

!**/testdata/**/*.env
!**/testdata/**/*.golden
!**/testdata/**/*.hcl
!**/testdata/**/*.json
!**/testdata/**/*.toml
!**/testdata/**/*.txt
!**/testdata/**/*.yaml

!/internal/completion/*/assets/*
!/test/shell/testdata/*_harness.*
!/testdata/completion/*
!**/testdata/**/fixtures/*

!**/_examples/**/configs/*.hcl
!**/_examples/**/configs/*.json
!**/_examples/**/configs/*.toml
!**/_examples/**/configs/*.yaml
!**/_examples/**/configs/*.yml

# ...even if they are in subdirectories
!*/

.agents
.opencode

# Never track dependency or build trees, even when a re-include rule matches inside them
/website/node_modules/

/third_party

.agents
.omp
.opencode
