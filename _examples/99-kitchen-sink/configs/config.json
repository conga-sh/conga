{
  "verbosity": 4,
  "format": "hcl",
  "cache": false,
  "api_secret": "json-secret-key-abc123",

  "features": {
    "http3": true,
    "compression": 1
  },

  "types": {
    "primitives": {
      "string-flag": "json-configured",
      "bool-flag": true,
      "int-flag": 101,
      "int8-flag": 9,
      "int16-flag": 161,
      "int32-flag": 3201,
      "int64-flag": 64001,
      "uint-flag": 201,
      "uint8-flag": 81,
      "uint16-flag": 1601,
      "uint32-flag": 32001,
      "uint64-flag": 64001,
      "float32-flag": 1.6,
      "float64-flag": 3.04,
      "tags": ["json", "prod", "monitored"],
      "ports": [8081, 8444, 9091]
    },
    "filesystem": {
      "input-file": "/etc/hosts",
      "output-dir": "/tmp",
      "log-file": "/var/log/demo.log",
      "data-dir": "/var/lib/demo",
      "editor": "sh",
      "hook": "deploy-hook"
    },
    "values": {
      "timeout": "2m",
      "endpoint": "https://json.example.com/v2",
      "max-size": "60MB",
      "level": "error",
      "shard-map": { "web": "2", "worker": "4" }
    }
  },

  "config": {
    "context": "staging",
    "maps": {
      "vars": { "LOG_LEVEL": "info", "APP_ENV": "qa", "DB_HOST": "db.local" },
      "labels": ["tier=api", "team=backend"]
    },
    "nested": {
      "zone": "us-west-2b",
      "count": 7
    }
  }
}
