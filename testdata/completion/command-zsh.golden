#compdef myapp
function _myapp_completion {
  local app_env_prefix=MYAPP_
  # The word being completed reaches the engine unescaped, like the words
  # before it. Inside a quote the user opened, PREFIX holds the text after
  # the quote; single-quoted text is literal, so it skips (Q). The quote
  # itself travels in CONGA_ZSH_QUOTE so the engine can continue it, and
  # CONGA_ZSH_BANGHIST=0 says a '!' inside double quotes needs no backslash.
  local quote="${compstate[quote]}"
  local current="${PREFIX}${SUFFIX}"
  [[ "$quote" == "'" ]] || current="${(Q)current}"

  local -a args
  if (( CURRENT >= 2 )); then
    args=("${(@Q)words[2,CURRENT-1]}" "$current")
  else
    args=("")
  fi

  local target="${words[1]}"
  local target_lead="${target%%/*}"
  if [[ "$target_lead" == '~'* ]]; then
    local target_name="${target_lead#\~}"
    if [[ -z "$target_name" ]]; then
      target="$HOME${target#\~}"
    elif [[ -n "${nameddirs[$target_name]}" ]]; then
      target="${nameddirs[$target_name]%/}${target#$target_lead}"
    fi
  fi
  target="${aliases[$target]:-$target}"

  local probe_context=":completion:${curcontext}:"

  # Honor the user's zsh completion styles: zstyle -T is true when the style
  # is unset, so an explicit false suppresses descriptions ("verbose") or
  # aliases ("show-aliases", the go-task convention), and an explicit true
  # restores the otherwise-suppressed bare-space flags ("bare-space-flags").
  # The sidebands apply only to the __complete invocation, never to the user's
  # environment, and use the application-prefixed names set by the generated
  # wrapper (app_env_prefix). The engine's list-colors patterns must match the
  # separator zsh renders between a match and its description, so the
  # list-separator style is forwarded too.
  local -a conga_env
  local user_list_separator
  zstyle -T "$probe_context" verbose || conga_env+=("${app_env_prefix}COMPLETION_DESCRIPTIONS=0")
  zstyle -T "$probe_context" show-aliases || conga_env+=("${app_env_prefix}COMPLETION_ALIASES=0")
  zstyle -t "$probe_context" bare-space-flags yes true 1 on && conga_env+=("${app_env_prefix}COMPLETION_BARE_SPACE_FLAGS=1")
  [[ -n "$quote" ]] && conga_env+=("CONGA_ZSH_QUOTE=${quote}")
  [[ -o banghist ]] || conga_env+=("CONGA_ZSH_BANGHIST=0")
  if zstyle -s "$probe_context" list-separator user_list_separator && [[ -n "$user_list_separator" ]]; then
    conga_env+=("CONGA_ZSH_LIST_SEPARATOR=${user_list_separator}")
  fi

  local lines
  if (( ${#conga_env} )); then
    lines="$(env "${conga_env[@]}" "$target" __complete zsh "${args[@]}" 2>/dev/null)" || lines=""
  else
    lines="$("$target" __complete zsh "${args[@]}" 2>/dev/null)" || lines=""
  fi

  local nl=$'\n' us=$'\x1f'
  local line tag display description composed prior
  local -a tags fields
  local keeporder=0
  local -A tag_displays tag_values

  local style_pattern=":completion:${curcontext}:*"
  local -a user_group_name user_list_colors
  local conga_list_colors=1

  # Probe-before-set: remove only this completer's own definitions from
  # earlier invocations (zstyle -d matches the pattern literally, so user
  # styles are never touched), then honor the styles the user configured for
  # this context. An empty group-name means "no headings", so an unset or
  # empty user value keeps the engine default; a non-empty value is left
  # untouched. list-colors is forwarded from the L record only when the user
  # has no non-empty value of their own (Oh-My-Zsh's empty default keeps
  # engine colors).
  zstyle -d "$style_pattern" group-name list-colors

  if ! zstyle -a "$probe_context" group-name user_group_name || [[ -z "${(j.:.)user_group_name}" ]]; then
    zstyle "$style_pattern" group-name ''
  fi

  if zstyle -a "$probe_context" list-colors user_list_colors && [[ -n "${(j.:.)user_list_colors}" ]]; then
    conga_list_colors=0
  fi

  for line in "${(@f)lines}"; do
    case "${line%%"$us"*}" in
      D)
        IFS=$us read -r -A fields <<<"${line#*"$us"}"
        [[ ",${fields[1]}," == *,noprefix,* ]] && (( ${+compstate} )) && compstate[insert]=''
        [[ ",${fields[1]}," == *,keeporder,* ]] && keeporder=1
        ;;
      L)
        (( conga_list_colors )) && zstyle "$style_pattern" list-colors "${line#*$us}"
        ;;
      M)
        _message -r "${line#*"$us"}"
        ;;
      C)
        IFS=$us read -r -A fields <<<"${line#*"$us"}"
        tag="${fields[1]}"
        display="${fields[2]}"
        composed="${display//:/\\:}"
        description="${fields[3]}"
        [[ -n "$description" ]] && composed+=":${description//:/\\:}"
        if [[ -z "${tag_displays[$tag]+x}" ]]; then
          tags+=("$tag")
        fi
        prior="${tag_displays[$tag]}"
        tag_displays[$tag]="${prior}${prior:+$nl}$composed"
        prior="${tag_values[$tag]}"
        tag_values[$tag]="${prior}${prior:+$nl}${fields[4]}"
        ;;
    esac
  done

  local -a displays values
  for tag in "${tags[@]}"; do
    displays=("${(@f)tag_displays[$tag]}")
    values=("${(@f)tag_values[$tag]}")
    if [[ -n "$tag" ]]; then
      # _describe removes one level of backslash escapes from the values and
      # cuts them at an unescaped colon, so escape both once more.
      values=("${(@)${(@)values//\\/\\\\}//:/\\:}")
      if (( keeporder )); then
        # The leading -V keeps the order when descriptions are shown, the
        # trailing one when the verbose style is false. list-grouped would
        # merge and reorder candidates that share a description, so it is
        # turned off for this tag while _describe runs.
        zstyle ":completion:${curcontext}:${tag}" list-grouped false
        _describe -V -t "$tag" "$tag" displays values -V "$tag" -Q -S ''
        zstyle -d ":completion:${curcontext}:${tag}" list-grouped
      else
        _describe -t "$tag" "$tag" displays values -Q -S ''
      fi
    elif (( keeporder )); then
      compadd -V conga-values -Q -S '' -a values
    else
      compadd -Q -S '' -a values
    fi
  done
}
compdef _myapp_completion myapp
