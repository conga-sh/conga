{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conga-docs",
  "compatibility_date": "2026-09-27", // Update to the day you deploy
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "previews": {},
  "routes": [
    {
      "pattern": "docs.conga.sh",
      "custom_domain": true
    },
    {
      "pattern": "docs-preview.conga.sh",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ]
}
